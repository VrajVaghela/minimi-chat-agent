# Model. Any server that speaks OpenAI chat completions.
# OpenAI: https://platform.openai.com/api-keys
# Groq:   https://console.groq.com/keys          (set OPENAI_BASE_URL=https://api.groq.com/openai/v1)
# OpenRouter: https://openrouter.ai/keys        (set OPENAI_BASE_URL=https://openrouter.ai/api/v1)
# Leave blank to run without a model. Answers then quote memory and sources directly.
OPENAI_API_KEY=

# Optional. Default https://api.openai.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional. Default gpt-4.1-mini. Use gpt-4.1 when you want a stronger writer.
OPENAI_MODEL=gpt-4.1-mini

# Search. auto uses Tavily if that key is set, otherwise Brave, otherwise no live search.
# tavily | brave | mock | auto
SEARCH_PROVIDER=auto

# Tavily, built for agents: https://app.tavily.com
TAVILY_API_KEY=

# Brave Search API: https://api-dashboard.search.brave.com/app/keys
BRAVE_SEARCH_API_KEY=

# IANA timezone for "Monday", "last Tuesday", and "3 November".
# Default Asia/Kolkata. Not a secret.
AGENT_TIMEZONE=Asia/Kolkata
